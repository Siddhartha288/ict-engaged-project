PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=digitalready
JWT_SECRET=change_me_to_a_long_random_string
# AI roadmap wording is optional. With no key the built-in rule-based roadmap is used.
# Gemini has a free tier (key from https://aistudio.google.com). If both keys are set,
# Gemini is used unless AI_PROVIDER=anthropic.
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=gemini

# Optional email (password-reset emails and reminders), via https://resend.com.
# Without these, nothing is emailed: admins issue reset links and reminders show in the app.
# RESEND_API_KEY=your_resend_key
# EMAIL_FROM=BizTransform <noreply@yourdomain.com>
# Base URL used in emailed links (defaults to the site the request came from)
# APP_URL=https://your-site.example
FRONTEND_ORIGIN=http://localhost:5173
